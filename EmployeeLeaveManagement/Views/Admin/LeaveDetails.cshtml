@model EmployeeLeaveManagement.ViewModels.LeaveRequestViewModel
@{
    ViewData["Title"] = "Leave Request Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="bi bi-info-circle"></i> Leave Request Details</h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Request ID:</strong>
                            <p>@Model.LeaveRequestId</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Status:</strong>
                            <p>
                                @if (Model.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark fs-6">@Model.Status</span>
                                }
                                else if (Model.Status == "Approved")
                                {
                                    <span class="badge bg-success fs-6">@Model.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6">@Model.Status</span>
                                }
                            </p>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <strong>Employee Name:</strong>
                            <p>@Model.EmployeeName</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>From Date:</strong>
                            <p>@Model.FromDate.ToString("dd-MMM-yyyy")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>To Date:</strong>
                            <p>@Model.ToDate.ToString("dd-MMM-yyyy")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Total Days:</strong>
                            <p><span class="badge bg-info fs-6">@Model.TotalDays days</span></p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <strong>Reason:</strong>
                            <p class="border p-3 bg-light">@Model.Reason</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Requested On:</strong>
                            <p>@Model.RequestedDate.ToString("dd-MMM-yyyy hh:mm tt")</p>
                        </div>
                        @if (Model.ProcessedDate.HasValue)
                        {
                            <div class="col-md-6">
                                <strong>Processed On:</strong>
                                <p>@Model.ProcessedDate.Value.ToString("dd-MMM-yyyy hh:mm tt")</p>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ProcessedByName))
                    {
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <strong>Processed By:</strong>
                                <p>@Model.ProcessedByName</p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.AdminComments))
                    {
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <strong>Admin Comments:</strong>
                                <p class="border p-3 bg-light">@Model.AdminComments</p>
                            </div>
                        </div>
                    }

                    @if (Model.Status == "Pending")
                    {
                        <hr />
                        <h5 class="mb-3">Action Required</h5>

                        <!-- Approve Form -->
                        <form asp-action="ApproveLeave" asp-route-id="@Model.LeaveRequestId" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="approveComments" class="form-label">Comments (Optional):</label>
                                <textarea name="adminComments" id="approveComments" class="form-control" rows="3" placeholder="Enter approval comments..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-success" onclick="return confirm('Are you sure you want to approve this leave request?')">
                                <i class="bi bi-check-circle"></i> Approve Leave
                            </button>
                        </form>

                        <!-- Reject Form -->
                        <form asp-action="RejectLeave" asp-route-id="@Model.LeaveRequestId" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="rejectComments" class="form-label">Rejection Reason (Optional):</label>
                                <textarea name="adminComments" id="rejectComments" class="form-control" rows="3" placeholder="Enter rejection reason..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to reject this leave request?')">
                                <i class="bi bi-x-circle"></i> Reject Leave
                            </button>
                        </form>
                    }

                    <hr />
                    <div class="d-grid gap-2">
                        <a asp-action="LeaveRequests" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Leave Requests
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>