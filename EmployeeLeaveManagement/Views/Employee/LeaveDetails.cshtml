@model EmployeeLeaveManagement.ViewModels.LeaveRequestViewModel
@{
    ViewData["Title"] = "Leave Request Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="bi bi-info-circle"></i> Leave Request Details</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Request ID:</strong>
                            <p>@Model.LeaveRequestId</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Status:</strong>
                            <p>
                                @if (Model.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark fs-6">@Model.Status</span>
                                }
                                else if (Model.Status == "Approved")
                                {
                                    <span class="badge bg-success fs-6">@Model.Status</span>
                                }
                                else if (Model.Status == "Cancelled")
                                {
                                    <span class="badge bg-secondary fs-6">@Model.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6">@Model.Status</span>
                                }
                            </p>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>From Date:</strong>
                            <p>@Model.FromDate.ToString("dd-MMM-yyyy")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>To Date:</strong>
                            <p>@Model.ToDate.ToString("dd-MMM-yyyy")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Total Days:</strong>
                            <p><span class="badge bg-info fs-6">@Model.TotalDays days</span></p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <strong>Reason:</strong>
                            <p class="border p-3 bg-light">@Model.Reason</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Requested On:</strong>
                            <p>@Model.RequestedDate.ToString("dd-MMM-yyyy hh:mm tt")</p>
                        </div>
                        @if (Model.ProcessedDate.HasValue)
                        {
                            <div class="col-md-6">
                                <strong>Processed On:</strong>
                                <p>@Model.ProcessedDate.Value.ToString("dd-MMM-yyyy hh:mm tt")</p>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ProcessedByName))
                    {
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <strong>Processed By:</strong>
                                <p>@Model.ProcessedByName</p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.AdminComments))
                    {
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <strong>Admin Comments:</strong>
                                <div class="alert alert-@(Model.Status == "Approved" ? "success" : "danger")">
                                    @Model.AdminComments
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.Status == "Pending")
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-hourglass-split"></i> Your leave request is pending approval from admin.
                        </div>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> Your leave request has been approved!
                        </div>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-x-circle"></i> Your leave request has been rejected.
                        </div>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <div class="alert alert-secondary">
                            <i class="bi bi-slash-circle"></i> This leave request has been cancelled.
                        </div>
                    }

                    <hr />

                    <div class="d-grid gap-2">
                        @if (Model.Status == "Pending")
                        {
                            <form asp-action="CancelLeave" asp-route-id="@Model.LeaveRequestId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to cancel this leave request?')">
                                    <i class="bi bi-x-circle"></i> Cancel Leave Request
                                </button>
                            </form>
                        }
                        <a asp-action="MyLeaves" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to My Leaves
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>