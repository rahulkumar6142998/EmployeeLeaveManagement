@model IEnumerable<EmployeeLeaveManagement.ViewModels.LeaveRequestViewModel>
@{
    ViewData["Title"] = "My Leaves";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-calendar-check"></i> My Leave Requests</h2>
        <a asp-action="ApplyLeave" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Apply for Leave
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Buttons -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="btn-group" role="group">
                <a asp-action="MyLeaves" class="btn @(string.IsNullOrEmpty(ViewBag.Status) ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-list"></i> All
                </a>
                <a asp-action="MyLeaves" asp-route-status="Pending" class="btn @(ViewBag.Status == "Pending" ? "btn-warning" : "btn-outline-warning")">
                    <i class="bi bi-hourglass-split"></i> Pending
                </a>
                <a asp-action="MyLeaves" asp-route-status="Approved" class="btn @(ViewBag.Status == "Approved" ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-check-circle"></i> Approved
                </a>
                <a asp-action="MyLeaves" asp-route-status="Rejected" class="btn @(ViewBag.Status == "Rejected" ? "btn-danger" : "btn-outline-danger")">
                    <i class="bi bi-x-circle"></i> Rejected
                </a>
                <a asp-action="MyLeaves" asp-route-status="Cancelled" class="btn @(ViewBag.Status == "Cancelled" ? "btn-secondary" : "btn-outline-secondary")">
                    <i class="bi bi-slash-circle"></i> Cancelled
                </a>
            </div>
        </div>
    </div>

    <!-- Leave Requests Table -->
    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>From Date</th>
                                <th>To Date</th>
                                <th>Days</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th>Requested On</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.LeaveRequestId</td>
                                    <td>@item.FromDate.ToString("dd-MMM-yyyy")</td>
                                    <td>@item.ToDate.ToString("dd-MMM-yyyy")</td>
                                    <td><span class="badge bg-info">@item.TotalDays days</span></td>
                                    <td>@(item.Reason.Length > 50 ? item.Reason.Substring(0, 50) + "..." : item.Reason)</td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">@item.Status</span>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <span class="badge bg-success">@item.Status</span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary">@item.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@item.Status</span>
                                        }
                                    </td>
                                    <td>@item.RequestedDate.ToString("dd-MMM-yyyy")</td>
                                    <td>
                                        <a asp-action="LeaveDetails" asp-route-id="@item.LeaveRequestId" class="btn btn-sm btn-info text-white">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        @if (item.Status == "Pending")
                                        {
                                            <form asp-action="CancelLeave" asp-route-id="@item.LeaveRequestId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to cancel this leave request?')">
                                                    <i class="bi bi-x-circle"></i> Cancel
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="text-muted mt-3">
                        @if (!string.IsNullOrEmpty(ViewBag.Status))
                        {
                            <text>No @ViewBag.Status leave requests found.</text>
                        }
                        else
                        {
                            <text>No leave requests found.</text>
                        }
                    </p>
                    <a asp-action="ApplyLeave" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Apply for Leave
                    </a>
                </div>
            }
        </div>
    </div>
</div>